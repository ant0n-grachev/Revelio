{
  "manifest_version": 3,
  "name": "Revelio",
  "version": "1.0.2",
  "description": "Reveals potentially hidden text on webpages (tiny font, invisible color, offscreen, etc.).",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Revelio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "128": "icon128.png"
    }
  }
}
